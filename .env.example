# 資料庫連線設定
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=gogin
DB_PASSWORD=a3935522
DB_NAME=goGinCRUD

# 時區設定
TZ=Asia/Taipei

# MySQL Docker 容器設定
MYSQL_ROOT_PASSWORD=a3935522
MYSQL_DATABASE=goGinCRUD
MYSQL_USER=gogin
MYSQL_PASSWORD=a3935522

# JWT Secret（建議使用強隨機字串）
# 以下為範例值，生產環境請使用 openssl rand -base64 32 生成新的密鑰
ACCESS_SECRET=ACCESS_SECRET
REFRESH_SECRET=REFRESH_SECRET


REDIS_ADDR=redis:6379
REDIS_PORT=6379

# bcrypt 雜湊成本（4~31），未設定時預設為 12；測試環境可設 4 以加速
BCRYPT_COST=12

LOG_LEVEL=debug

# 請求層逾時（time.ParseDuration 格式，例 10s / 1m），預設 10s
# /stream/、/socket.io/、/tasks/ 豁免
REQUEST_TIMEOUT=10s
