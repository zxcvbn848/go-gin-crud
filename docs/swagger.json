                    "account"
                ],
                "summary": "獲取帳戶餘額",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/go-gin-crud_internal_dto.AccountResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "設置帳戶初始餘額",
                "tags": [
                    "account"
                ],
                "summary": "設置餘額",
                "parameters": [
                    {
                        "description": "餘額",
                        "name": "balance",
